# دفة — إعدادات جذر الموقع (يُنشر هذا الملف مع بناء الواجهة إلى public_html/.htaccess)
DirectoryIndex index.html index.php
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
    RewriteEngine On

    # النطاق القانوني: www → بدون www (نسخة واحدة للمحركات)، مع إزالة الشرطة الأخيرة في الخطوة نفسها
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*?)/?$ https://%1/$1 [R=301,L]

    # /index.html → / (نسخة واحدة للصفحة الرئيسية)
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # بلا شرطة أخيرة: /about/ → /about (ما عدا المجلدات الحقيقية ومسارات API)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Handle Authorization Header (required for Laravel API tokens)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve uploaded files: /storage/* → daffa-backend/storage/app/public/*
    RewriteRule ^storage/(.*)$ daffa-backend/storage/app/public/$1 [END]

    # Block direct access to daffa-backend folder
    RewriteRule ^daffa-backend(/.*)?$ - [F,L]

    # Route /api/* and signed /pdf/* (invoices, plan documents) requests to Laravel index.php
    RewriteCond %{REQUEST_URI} ^/(api|pdf)/
    RewriteRule ^ index.php [L]

    # خريطة الموقع تُولَّد تلقائيًا من Laravel (الصفحات القابلة للفهرسة وتاريخ آخر تعديل)
    RewriteRule ^sitemap\.xml$ index.php [L]

    # الصفحات العامة → Laravel يحقن في index.html عنوان الصفحة ووصفها ورابطها القانوني وبياناتها المنظّمة ومحتواها
    RewriteRule ^(about|services|pricing|contact|privacy|terms|login|register)?$ index.php [L]

    # Serve existing static files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
</IfModule>

# أي مسار آخر غير موجود → الواجهة نفسها بحالة 404 (تعرض صفحة «غير موجودة»)
ErrorDocument 404 /index.html

# ملفات الإعداد والمستودع لا تُخدم أبدًا
<FilesMatch "^\.(env|git|htpasswd)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # الملفات ذات البصمة في اسمها (assets/*-xxxxxxxx.js|css) لا تتغير أبدًا → تخزين سنة
    <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # الخطوط والصور والفيديو والأدلة → 30 يومًا
    <FilesMatch "\.(woff2|png|jpg|jpeg|webp|svg|ico|mp4|webm|pdf|docx)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # الصفحة الرئيسية وملفات الفهرسة → يُتحقق منها كل مرة حتى تظهر التحديثات فورًا
    <FilesMatch "^(index\.html|manifest\.webmanifest|robots\.txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
